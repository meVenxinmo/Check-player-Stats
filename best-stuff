local function refresh()
	for p, c in pairs(cards) do
		if not p.Parent then
			c:Destroy()
			cards[p] = nil
			found[p] = nil
			lastScan[p] = nil
			roleCache[p] = nil
		end
	end
	for i, player in ipairs(Players:GetPlayers()) do
		local card = cards[player] or makeCard(player)
		cards[player] = card
		card.LayoutOrder = i
		local raws = {}
		for _, key in ipairs(KEYS) do
			local a, b = rawStat(player, key)
			raws[key] = {a, b}
		end
		local mode = playerMode(raws)
		local lines, any = {}, false
		for _, key in ipairs(KEYS) do
			local v, lv, exact = resolveStat(key, raws[key][1], raws[key][2], mode)
			if v or lv then
				any = true
				lines[#lines + 1] = key .. ": " .. (v and fmt(v) or "?") .. " (Lv. " .. (lv and ((exact and "" or "~") .. fmt(lv)) or "?") .. ")"
			else
				lines[#lines + 1] = key .. ": N/A"
			end
		end
		if not any then
			lines[#lines + 1] = "No data found yet"
		end
		local text = table.concat(lines, "\n")
		if card.Info.Text ~= text then
			card.Info.Text = text
		end
		local r = getRole(player)
		local extra = {}
		for k, v in pairs(player:GetAttributes()) do
			if v and hasWord(k, ATTRWORDS) then
				extra[#extra + 1] = k .. "=" .. tostring(v)
			end
		end
		local txt = "Player"
		if r.mod then
			txt = "MOD - " .. r.text
		end
		if #extra > 0 then
			txt = txt .. " [" .. table.concat(extra, ", ") .. "]"
		end
		if card.Role.Text ~= txt then
			card.Role.Text = txt
		end
		card.Role.TextColor3 = r.mod and Color3.fromRGB(255, 170, 60) or Color3.fromRGB(185, 185, 190)
	end
end

task.spawn(function()
	local t = 0
	while running and gui.Parent do
		if t % 10 == 0 then
			for _, p in ipairs(Players:GetPlayers()) do
				pcall(scanPlayer, p)
			end
		else
			for _, p in ipairs(Players:GetPlayers()) do
				if not found[p] and (not lastScan[p] or os.clock() - lastScan[p] > 8) then
					pcall(scanPlayer, p)
				end
			end
		end
		if t % 15 == 0 then
			pcall(scanWorld)
		end
		pcall(refresh)
		t = t + 1
		task.wait(2)
	end
end)
