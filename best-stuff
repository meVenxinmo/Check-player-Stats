local MECH = {
	maxsize = {
		value = function(lv)
			return 50 * lv * (lv + 1)
		end,
		level = function(v)
			return (-1 + math.sqrt(1 + 4 * v / 50)) / 2
		end,
	},
	eatspeed = {
		value = function(lv)
			return 1 + 0.2 * (lv - 1)
		end,
		level = function(v)
			return (v - 1) / 0.2 + 1
		end,
	},
	multiplier = {
		value = function(lv)
			return lv
		end,
		level = function(v)
			return v
		end,
	},
	speed = {
		value = function(lv)
			return 12 + 2 * (lv - 1)
		end,
		level = function(v)
			return (v - 12) / 2 + 1
		end,
	},
}

local function normStr(s)
	return string.lower((tostring(s):gsub("[^%a]", "")))
end

local function hasWord(name, words)
	local l = string.lower(tostring(name))
	for _, w in ipairs(words) do
		if l:find(w, 1, true) then
			return true
		end
	end
	return false
end

local function toNum(v)
	if type(v) == "number" then
		return v
	end
	if type(v) == "string" then
		return tonumber((v:gsub(",", "")))
	end
end

local function fmt(v)
	local r = math.floor(v * 10 + 0.5) / 10
	local s = tostring(r)
	local int, frac = s:match("^(-?%d+)(%.?%d*)$")
	if not int then
		return s
	end
	local sign = ""
	if int:sub(1, 1) == "-" then
		sign = "-"
		int = int:sub(2)
	end
	int = int:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	return sign .. int .. frac
end

