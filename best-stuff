local function setHidden(v)
	if busy or v == hidden then
		return
	end
	busy = true
	hidden = v
	if v then
		confirm.Visible = false
		savedPos = main.Position
		bar.Position = UDim2.new(barHome.X.Scale, barHome.X.Offset, 0, -50)
		bar.Visible = true
		TweenService:Create(bar, SLIDE, {Position = barHome}):Play()
		local t = TweenService:Create(main, SLIDE, {Position = UDim2.new(savedPos.X.Scale, savedPos.X.Offset, 0, -(main.AbsoluteSize.Y + 60))})
		t.Completed:Connect(function()
			main.Visible = false
			busy = false
		end)
		t:Play()
	else
		main.Visible = true
		TweenService:Create(bar, SLIDE, {Position = UDim2.new(barHome.X.Scale, barHome.X.Offset, 0, -50)}):Play()
		local t = TweenService:Create(main, SLIDE, {Position = savedPos})
		t.Completed:Connect(function()
			bar.Visible = false
			busy = false
		end)
		t:Play()
	end
end

