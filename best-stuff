local KEYSET = {}
for _, k in ipairs(KEYS) do
	KEYSET[normStr(k)] = true
end
local SUFFIX = {value = true, amount = true, level = true, lv = true, lvl = true, levels = true, upgrade = true, upgrades = true}
local LEAFV = {value = true, amount = true, current = true, level = true, lv = true, lvl = true, levels = true}
local ATTRCLASS = {Player = true, Folder = true, Configuration = true, Humanoid = true, Model = true}

local function isTarget(nk)
	if KEYSET[nk] then
		return true
	end
	for k in pairs(KEYSET) do
		if nk:sub(1, #k) == k and SUFFIX[nk:sub(#k + 1)] then
			return true
		end
		if nk == "level" .. k or nk == "lv" .. k or nk == "current" .. k then
			return true
		end
	end
	return false
end

local function nameHit(name, parentName)
	local nk = normStr(name)
	if isTarget(nk) then
		return true
	end
	if parentName and LEAFV[nk] and KEYSET[normStr(parentName)] then
		return true
	end
	return false
end

local MAXPER = 120
local found = {}
local lastScan = {}
local seq = 0

local function ownerOf(obj)
	local path = {}
	local p = obj
	local guard = 0
	while p and p ~= game and guard < 40 do
		guard = guard + 1
		local o
		if p:IsA("Player") then
			o = p
		else
			o = Players:GetPlayerFromCharacter(p) or byName[p.Name] or byId[tonumber(p.Name) or -1]
		end
		if o then
			local rev = {}
			for i = #path, 1, -1 do
				rev[#rev + 1] = path[i]
			end
			return o, rev
		end
		path[#path + 1] = p.Name
		p = p.Parent
	end
end

local function addFound(player, obj, attr, base)
	local f = found[player]
	if not f then
		f = {n = 0, list = {}}
		found[player] = f
	end
	local id = attr and ("a:" .. attr) or "v"
	local slot = f.list[obj]
	if not slot then
		if f.n >= MAXPER then
			return
		end
		slot = {}
		f.list[obj] = slot
	end
	if not slot[id] then
		f.n = f.n + 1
		seq = seq + 1
		local segs = {}
		for i, seg in ipairs(base) do
			segs[i] = normStr(seg)
		end
		if attr then
			segs[#segs + 1] = normStr(attr)
		end
		slot[id] = {s = segs, obj = obj, attr = attr, q = seq}
	end
end

local function considerInstance(obj)
	local isV = obj:IsA("ValueBase")
	local parentName = obj.Parent and obj.Parent.Name or nil
	local wantV = isV and nameHit(obj.Name, parentName)
	local attrNames
	if isV or ATTRCLASS[obj.ClassName] then
		for name in pairs(obj:GetAttributes()) do
			if nameHit(name, obj.Name) then
				attrNames = attrNames or {}
				attrNames[#attrNames + 1] = name
			end
		end
	end
	if not wantV and not attrNames then
		return
	end
	if obj:FindFirstAncestorOfClass("PlayerGui") then
		return
	end
	local owner, base = ownerOf(obj)
	if not owner then
		return
	end
	if wantV then
		addFound(owner, obj, nil, base)
	end
	if attrNames then
		for _, name in ipairs(attrNames) do
			addFound(owner, obj, name, base)
		end
	end
end

local function scanTreeLight(root)
	pcall(considerInstance, root)
	local n = 0
	for _, o in ipairs(root:GetDescendants()) do
		pcall(considerInstance, o)
		n = n + 1
		if n % 1500 == 0 then
			task.wait()
			if not running then
				return
			end
		end
	end
end

local SKIP = {PlayerGui = true, Backpack = true, StarterGear = true, PlayerScripts = true}
local function scanPlayer(plr)
	pcall(considerInstance, plr)
	for _, c in ipairs(plr:GetChildren()) do
		if not SKIP[c.ClassName] then
			scanTreeLight(c)
		end
	end
	local ch = plr.Character
	if ch then
		pcall(considerInstance, ch)
		for _, c in ipairs(ch:GetChildren()) do
			if c:IsA("ValueBase") or c:IsA("Folder") or c:IsA("Configuration") or c:IsA("Humanoid") then
				scanTreeLight(c)
			end
		end
	end
	lastScan[plr] = os.clock()
end

